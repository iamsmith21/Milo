generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  title            String
  location         String
  capacity         Int
  category         String
  confirmedPlayers Int      @default(1)
  hasJoined        Boolean  @default(true)
  authorId Int
  author User @relation(fields: [authorId], references: [id])
  messages Message[]
}

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  name String
  plans Plan[]
  messages Message[]
}

model Message {
  id Int @id @default(autoincrement())
  text String
  planId Int
  plan Plan @relation(fields: [planId], references: [id])
  userId Int
  user User @relation(fields: [userId], references:[id])
  createdAt DateTime @default(now())
}