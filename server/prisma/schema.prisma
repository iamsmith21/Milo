generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  title            String
  location         String
  capacity         Int
  category         String
  confirmedPlayers Int      @default(1)
  hasJoined        Boolean  @default(true)
}
